# Copia este archivo como ".env" (nunca lo subas a GitHub).
# Credenciales de https://developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=TU_CLIENT_ID
PAYPAL_CLIENT_SECRET=TU_SECRET
# "sandbox" = pruebas sin cobrar | "live" = cobros reales
PAYPAL_MODE=sandbox
PORT=3000

# ---- Correos de confirmación ----
# Correo donde TÚ recibes el aviso de cada pedido nuevo
OWNER_EMAIL=tucorreo@gmail.com
MAIL_FROM_NAME=Ko'olel Artesanías

# OPCIÓN A: Gmail (gratis, funciona en tu PC; NO funciona en Render gratis)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=contraseña_de_aplicacion_de_16_letras

# OPCIÓN B: Brevo (gratis, funciona en Render). Si pones BREVO_API_KEY se usa esta.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=tucorreo_verificado_en_brevo@gmail.com

# ---- Base de datos (Postgres) ----
# Cadena de conexión de tu base gratuita en https://neon.tech (ver README)
DATABASE_URL=postgres://usuario:contraseña@host/nombre_basedatos

# ---- Panel de administración: /admin.html ----
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esto_por_algo_seguro

# ---- Webhook de PayPal (opcional pero recomendado) ----
# Lo obtienes al registrar tu URL de webhook en developer.paypal.com (ver README)
PAYPAL_WEBHOOK_ID=
